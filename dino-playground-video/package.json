{
  "name": "dino-playground-video",
  "private": true,
  "version": "0.1.0",
  "description": "성운이와 공룡 친구들의 놀이터 안전 약속 — Remotion 2분 애니메이션",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-source.mjs",
    "validate": "node scripts/validate.mjs",
    "preprocess": "node scripts/preprocess-characters.mjs",
    "dev": "remotion studio src/index.ts",
    "stills": "node scripts/render-stills.mjs",
    "render:preview": "node scripts/render-preview.mjs",
    "render:final": "node scripts/render-final.mjs",
    "qa": "node scripts/qa.mjs",
    "typecheck": "tsc --noEmit",
    "all": "npm run sync && npm run validate && npm run preprocess && npm run stills && npm run render:preview && npm run render:final && npm run qa",
    "postinstall": "node scripts/sync-source.mjs --quiet"
  },
  "dependencies": {
    "@fontsource/jua": "^5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3"
  }
}
